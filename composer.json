{
    "name": "kuzium/orbit-api-client",
    "version": "0.3.0",
    "description": "The stable, external-integration surface of the Orbit API. Authenticate with an API key (Settings > API Keys) via the X-Api-Key header.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/Kuzium-Technologies/orbit-api-client-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Kuzium Technologies",
            "homepage": "https://github.com/Kuzium-Technologies"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "KuziumOrbitClient\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KuziumOrbitClient\\Test\\": "test/"
        }
    }
}
